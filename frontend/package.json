{
  "name": "observatorio-ietsi-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prepare:projects": "python3 scripts/convert-projects-data.py",
    "prepare:units": "python3 scripts/convert-research-units-data.py",
    "validate:publications": "node scripts/validate-publication-data.mjs",
    "validate:researchers": "node scripts/validate-researcher-data.mjs",
    "validate:projects": "node scripts/validate-project-data.mjs",
    "validate:units": "node scripts/validate-research-units-data.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.1.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
